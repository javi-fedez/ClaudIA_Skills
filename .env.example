# ============================================================
# ClaudIA — Plantilla de variables de entorno
# ------------------------------------------------------------
# Copia este archivo a `.env` y rellena los valores reales.
# `.env` está en .gitignore y NUNCA debe committearse.
# Los marcadores aquí definidos son los placeholders usados
# en la documentación de docs/skills/.
# ============================================================

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDIA_MODEL=claude-sonnet-4-6
CLAUDIA_MAX_ITERATIONS=20
CLAUDIA_LOG_LEVEL=INFO

# --- Servidor de archivos públicos (skill ops-publish-content) ---
# Dominio del servidor nginx que sirve los archivos generados.
FILES_DOMAIN=files.example.com
# Path que actúa como token de acceso (la única protección del servidor).
# Genera uno aleatorio largo, p.ej.: openssl rand -hex 12
FILES_TOKEN_PATH=tu_token_secreto_de_acceso
# Nombre del contenedor Docker que sirve los archivos.
FILES_CONTAINER=files-server

# --- WordPress (skill seo-wordpress-publish) ---
# Sitio 1
WP_SITE1_URL=https://tu-sitio-1.example.com
WP_SITE1_USER=tu_usuario
WP_SITE1_PASSWORD=tu_application_password
# Sitio 2
WP_SITE2_URL=https://tu-sitio-2.example.com
WP_SITE2_USER=tu_usuario
WP_SITE2_PASSWORD=tu_application_password

# --- Microsoft 365 / Azure (skills comms-outlook-email, ops-calendar) ---
AZURE_CLIENT_ID=id-de-la-app-registration-en-azure
AZURE_TENANT_ID=id-del-tenant-de-m365
AZURE_CLIENT_SECRET=secreto-de-la-app

# --- NotebookLM (skill research-notebooklm) ---
# JSON de autenticación (cookies + tokens). Caduca en días/semanas.
NOTEBOOKLM_AUTH_JSON={"cookies":"...","tokens":"..."}
